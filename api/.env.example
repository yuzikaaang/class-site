# ============================================================
# 后端环境变量示例
# ------------------------------------------------------------
# 复制这份文件，把真实值填进 Vercel：
#   项目 → Settings → Environment Variables
# ⚠️ 千万别把真实值提交到 git 仓库里
# ============================================================

# Neon 数据库连接串
# 从 Neon 控制台 → 你的项目 → Connection Details 里复制
# 形如：postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# 建议用带 -pooler 的那个地址（连接池版，Serverless 场景更稳）
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# 管理员用户名，多个用英文逗号分隔。
# 这个名单里的用户名注册后会直接成为管理员。
# 注意：第一个注册的用户无论叫什么都会自动成为管理员。
ADMIN_USERS=zikang

# 允许跨域访问的前端来源（重要！）
# 前端在 GitHub Pages，API 在 Vercel，属于跨站请求，必须列白名单。
# 多个用英文逗号分隔，不要带结尾斜杠。
# 例如：https://yuzikaaang.github.io,http://localhost:8080
# 本地开发想图省事可以填 *（上线务必改成具体域名）
ALLOW_ORIGINS=https://yuzikaaang.github.io,http://localhost:8080

# 登录状态保持多少天（默认 30）
SESSION_DAYS=30

# 是否允许自助注册：1 = 允许（默认），0 = 关闭（只能管理员开号）
ALLOW_REGISTER=1
